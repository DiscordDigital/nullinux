#!/bin/bash

passwd() {
    if [ -z "$1" ]; then
        USERNAME=$USER
    else
        USERNAME="$1"
    fi

    # Read password twice for confirmation
    while true; do
        printf "Enter new password for %s: " "$USERNAME"
        read -s PASS1
        echo
        printf "Retype new password: "
        read -s PASS2
        echo
        [ "$PASS1" = "$PASS2" ] && break
        echo "Passwords do not match, try again."
    done

    # Ensure /etc/shadow exists
    touch /etc/shadow
    chmod 600 /etc/shadow

    # Generate SHA-512 hash
    HASH=$(openssl passwd -6 "$PASS1")

    # Support for symlinked shadow
    shadowfile=/etc/shadow
    if [ -L "/etc/shadow" ]; then
        shadowfile=$(readlink $shadowfile)
    fi

    # Remove old entry if exists
    grep -v "^$USERNAME:" $shadowfile > /etc/shadow.tmp
    mv /etc/shadow.tmp $shadowfile

    # Add new entry
    echo "$USERNAME:$HASH::0:99999:7:::" >> $shadowfile

    echo "Password updated for $USERNAME"
}

# Call passwd if script executed directly
if [ "${BASH_SOURCE:-$0}" = "$0" ]; then
    passwd "$@"
fi
